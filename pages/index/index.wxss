/* 云鑫计算器 · 清爽金融工具风
   原则：信任感、数字优先、触控友好；不改类名体系，兼容现有 WXML */

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 72rpx;
  background:
    radial-gradient(120% 60% at 0% 0%, rgba(26, 92, 255, 0.10) 0%, transparent 55%),
    radial-gradient(90% 50% at 100% 0%, rgba(15, 159, 138, 0.08) 0%, transparent 50%),
    #eef2f7;
  color: #0b1220;
}

/* —— 顶栏品牌 —— */
.hero {
  margin-bottom: 18rpx;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #0b1f44 0%, #12356f 55%, #0f766e 140%);
  box-shadow: 0 18rpx 40rpx rgba(11, 31, 68, 0.22);
}

.masthead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.brand-logo {
  width: 76rpx;
  height: 76rpx;
  display: block;
}

.masthead-copy {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  min-width: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-badge {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.88);
  font-size: 20rpx;
  font-weight: 650;
}

/* —— 导航壳：贷款类型 + 工具 —— */
.nav-shell {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.switch-card {
  margin-bottom: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}

.switch-card::before,
.panel::before,
.schedule::before {
  display: none;
}

.section-label {
  display: block;
  margin-bottom: 12rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.section-label.inner {
  margin-top: 20rpx;
  margin-bottom: 4rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin: 16rpx 0 0;
  animation: none;
}

.tool {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 16rpx;
  background: #f7f9fc;
  color: #334155;
  font-size: 26rpx;
  font-weight: 750;
  transition: transform 140ms ease, background 140ms ease, color 140ms ease, box-shadow 140ms ease;
}

.tool.active {
  border-color: transparent;
  background: linear-gradient(135deg, #1a5cff 0%, #0e3eb8 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(26, 92, 255, 0.28);
}

.tool-guide {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin: 16rpx 0 0;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f0f5ff;
  border: 0;
}

.tool-guide-text {
  flex: 1;
  min-width: 0;
  color: #475569;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

.sample-btn {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1a5cff;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(26, 92, 255, 0.12);
}

/* —— 表单面板 —— */
.panel,
.schedule {
  position: relative;
  overflow: hidden;
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.05);
}

.field {
  display: grid;
  grid-template-columns: 168rpx 1fr 56rpx;
  align-items: center;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 16rpx;
  background: #f7f9fc;
  transition: border-color 140ms ease, background 140ms ease, box-shadow 140ms ease;
}

.field:first-child {
  margin-top: 0;
}

.label {
  color: #475569;
  font-size: 24rpx;
  font-weight: 700;
}

.input {
  min-height: 84rpx;
  color: #0b1220;
  font-size: 34rpx;
  font-weight: 800;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.input-placeholder {
  color: #94a3b8;
  font-size: 24rpx;
  font-weight: 600;
}

.unit {
  color: #1a5cff;
  font-size: 24rpx;
  font-weight: 800;
  text-align: right;
}

.quick-row {
  display: flex;
  gap: 10rpx;
  margin: 14rpx 0 6rpx;
  flex-wrap: wrap;
}

.quick-row text {
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  font-size: 23rpx;
  font-weight: 750;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #eef2f7;
}

.switch-card .segmented {
  margin-top: 0;
}

.segmented.two {
  grid-template-columns: repeat(2, 1fr);
}

.segmented text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  border-radius: 12rpx;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 750;
  transition: transform 140ms ease, background 140ms ease, color 140ms ease;
}

.segmented text.active {
  background: #ffffff;
  color: #0e3eb8;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.ratio-amount-hint {
  display: block;
  margin: 2rpx 0 8rpx 8rpx;
  color: #0f9f8a;
  font-size: 22rpx;
  font-weight: 750;
}

.field-hint {
  display: block;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.55;
}

.form-hint {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.45;
}

.form-error {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(194, 65, 12, 0.22);
  border-radius: 14rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.45;
}

/* —— 结果区 —— */
.result-block {
  margin-top: 22rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.result-summary {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #0b1f44 0%, #12356f 60%, #0f766e 160%);
  box-shadow: 0 14rpx 30rpx rgba(11, 31, 68, 0.18);
  border: 0;
}

.result-summary-label {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.result-summary-text {
  display: block;
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.result-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.result-copy-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  border: 0;
  border-radius: 999rpx;
  background: #1a5cff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(26, 92, 255, 0.22);
}

.result-copy-btn::after {
  border: 0;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.metric {
  min-height: 118rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 16rpx;
  background: #f7f9fc;
}

.metric text {
  display: block;
}

.metric text:first-child {
  color: #64748b;
  font-size: 21rpx;
  font-weight: 700;
}

.metric text:last-child {
  margin-top: 12rpx;
  color: #0b1220;
  font-size: 30rpx;
  font-weight: 800;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

.metric.main {
  grid-column: 1 / -1;
  min-height: 140rpx;
  border: 0;
  background: linear-gradient(135deg, #1a5cff 0%, #0e3eb8 70%, #0f9f8a 160%);
  box-shadow: 0 14rpx 28rpx rgba(26, 92, 255, 0.22);
}

.metric.main text {
  color: #ffffff;
}

.metric.main text:first-child {
  color: rgba(255, 255, 255, 0.82);
}

.metric.main text:last-child {
  font-size: 44rpx;
  letter-spacing: 0.5rpx;
}

.metric text.negative,
.metric.main text.negative {
  color: #c2410c;
}

.metric.main text.negative {
  color: #ffd7c2;
}

/* —— 明细表 —— */
.schedule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
  color: #0b1220;
}

.schedule-title {
  font-size: 28rpx;
  font-weight: 800;
}

.schedule-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex-wrap: wrap;
}

.schedule-pill,
.schedule-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  font-size: 21rpx;
  font-weight: 750;
}

.schedule-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  white-space: nowrap;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.schedule-pill {
  background: #e8efff;
  color: #1a5cff;
}

.schedule-count {
  background: #eef2f7;
  color: #475569;
}

.schedule-action.share {
  width: 76rpx;
  background: #e8efff;
  color: #1a5cff;
}

.schedule-action.export {
  width: 132rpx;
  background: #1a5cff;
  color: #ffffff;
}

.schedule-action::after {
  border: 0;
}

.schedule-truncate-note {
  display: block;
  margin: 0 0 12rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
}

.table-scroll {
  width: 100%;
  border-radius: 14rpx;
  background: #f7f9fc;
  padding: 8rpx 12rpx;
}

.table-inner {
  min-width: 100%;
  width: 100%;
}

.table-head,
.table-row {
  display: grid;
  /* 月份窄一点，金额列均分，避免余额被裁切 */
  grid-template-columns: 108rpx 1fr 1fr 1fr 1fr;
  gap: 8rpx;
  align-items: center;
  min-height: 64rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
}

.table-head text {
  color: #1a5cff;
  font-size: 21rpx;
  font-weight: 800;
}

.table-row text {
  color: #334155;
  font-size: 22rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* 金额列允许略缩小字号完整显示，优先看全数 */
.table-row text:not(:first-child) {
  font-size: 21rpx;
}

.table-head text:not(:first-child),
.table-row text:not(:first-child) {
  text-align: right;
}

.table-row:last-child {
  border-bottom: 0;
}

.assumption-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.65;
  border: 1rpx solid rgba(15, 23, 42, 0.04);
}

/* 触控反馈 */
.tool:active,
.quick-row text:active,
.segmented text:active,
.sample-btn:active,
.result-copy-btn:active,
.schedule-action:active {
  transform: scale(0.98);
  opacity: 0.96;
}

/* 兼容旧类名（已无顶部复制按钮） */
.copy-btn {
  display: none;
}

.copy-btn::after {
  border: 0;
}
