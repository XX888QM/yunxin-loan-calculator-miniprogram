        <text class="label">{{prepayForm.penaltyType == 'fixed' ? '违约金额' : '违约金比例'}}</text>
        <input class="input" placeholder-class="input-placeholder" placeholder="确认没有请填 0；未核对留空" type="digit" value="{{prepayForm.penaltyValue}}" data-form="prepayForm" data-field="penaltyValue" bindinput="onInput" />
        <text class="unit">{{prepayForm.penaltyType == 'fixed' ? (prepayForm.unit == 'wan' ? '万' : '元') : '%'}}</text>
      </view>
      <view class="segmented two">
        <text class="{{prepayForm.reduceMode == 'term' ? 'active' : ''}}" data-form="prepayForm" data-field="reduceMode" data-value="term" bindtap="setFormValue">缩短期限</text>
        <text class="{{prepayForm.reduceMode == 'payment' ? 'active' : ''}}" data-form="prepayForm" data-field="reduceMode" data-value="payment" bindtap="setFormValue">降低月供</text>
      </view>
      <view class="{{prepayResult.errorLevel == 'error' ? 'form-error' : 'form-hint'}}" wx:if="{{prepayResult.error}}">{{prepayResult.error}}</view>
      <view class="result-block">
        <view class="result-summary" wx:if="{{prepayResult.summaryText}}">
          <text class="result-summary-label">一句话结论</text>
          <text class="result-summary-text">{{prepayResult.summaryText}}</text>
        </view>
        <text class="field-hint" wx:if="{{prepayResult.scopeText}}">{{prepayResult.scopeText}}</text>
        <view class="result-actions" wx:if="{{prepayResult.valid}}"><button class="result-copy-btn" bindtap="copySummary">复制结果</button></view>
        <view class="result-grid">
          <view class="metric"><text>当前剩余本金</text><text>{{prepayResult.remainingBalance}}</text></view>
          <view class="metric"><text>提前还后本金</text><text>{{prepayResult.afterPrepayBalance}}</text></view>
          <view class="metric"><text>本期应计利息</text><text>{{prepayResult.accruedInterest}}</text></view>
          <view class="metric main"><text>本次结算预计支付</text><text>{{prepayResult.settlementTotal}}</text></view>
          <view class="metric"><text>预计省后续利息</text><text>{{prepayResult.futureInterestSaved}}</text></view>
          <view class="metric"><text>违约金</text><text>{{prepayResult.penalty}}</text></view>
          <view class="metric main"><text>{{prepayResult.netSavedLabel}}</text><text class="{{prepayResult.netSavedNegative ? 'negative' : ''}}">{{prepayResult.penaltyKnown ? prepayResult.netFutureInterestSaved : prepayResult.futureInterestSaved}}</text></view>
          <view class="metric"><text>新剩余期数</text><text>{{prepayResult.newRemainingMonths}}期</text></view>
          <view class="metric"><text>原月供</text><text>{{prepayResult.oldMonthlyPayment}}</text></view>
          <view class="metric"><text>新月供</text><text>{{prepayResult.newMonthlyPayment}}</text></view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{activeTool == 'lpr'}}" class="panel">
    <text class="section-label">LPR 变动情景</text>
    <view class="field">
      <text class="label">贷款本金</text>
      <input class="input" placeholder-class="input-placeholder" placeholder="输入贷款本金" type="digit" value="{{lprForm.principal}}" data-form="lprForm" data-field="principal" bindinput="onInput" />
      <text class="unit">{{lprForm.unit == 'wan' ? '万' : '元'}}</text>
    </view>
    <view class="segmented two">
      <text class="{{lprForm.unit == 'yuan' ? 'active' : ''}}" data-form="lprForm" data-field="unit" data-value="yuan" bindtap="setFormValue">按元</text>
      <text class="{{lprForm.unit == 'wan' ? 'active' : ''}}" data-form="lprForm" data-field="unit" data-value="wan" bindtap="setFormValue">按万</text>
    </view>
    <view class="field">
      <text class="label">还款期数</text>
      <input class="input" placeholder-class="input-placeholder" placeholder="例如 360" type="number" value="{{lprForm.months}}" data-form="lprForm" data-field="months" bindinput="onInput" />
      <text class="unit">期</text>
    </view>
    <view class="segmented two">
      <text class="{{lprForm.method == 'equalInstallment' ? 'active' : ''}}" data-form="lprForm" data-field="method" data-value="equalInstallment" bindtap="setFormValue">等额本息</text>
      <text class="{{lprForm.method == 'equalPrincipal' ? 'active' : ''}}" data-form="lprForm" data-field="method" data-value="equalPrincipal" bindtap="setFormValue">等额本金</text>
    </view>
    <view class="field">
      <text class="label">合同当前 5 年期 LPR</text>
      <input class="input" placeholder-class="input-placeholder" placeholder="例如 3.6" type="digit" value="{{lprForm.initialLpr}}" data-form="lprForm" data-field="initialLpr" bindinput="onInput" />
      <text class="unit">%</text>
    </view>
    <view class="field">
      <text class="label">合同加点</text>
      <input class="input" placeholder-class="input-placeholder" placeholder="例如 -30 或 0" type="text" value="{{lprForm.spreadBps}}" data-form="lprForm" data-field="spreadBps" bindinput="onInput" />
      <text class="unit">bp</text>
    </view>
    <view class="field">
      <text class="label">情景起始期数</text>
      <input class="input" placeholder-class="input-placeholder" placeholder="例如第 13 期" type="number" value="{{lprForm.repriceMonth}}" data-form="lprForm" data-field="repriceMonth" bindinput="onInput" />
      <text class="unit">期</text>
    </view>
    <view class="field">
      <text class="label">假设调整后 5 年期 LPR</text>
      <input class="input" placeholder-class="input-placeholder" placeholder="例如 3.3" type="digit" value="{{lprForm.scenarioLpr}}" data-form="lprForm" data-field="scenarioLpr" bindinput="onInput" />
      <text class="unit">%</text>
    </view>
    <text class="field-hint">仅适用于以 5 年期 LPR 定价的合同。本工具是手动情景，不联网获取 LPR；实际重定价以合同和最新还款计划为准。</text>
    <view class="{{lprResult.errorLevel == 'error' ? 'form-error' : 'form-hint'}}" wx:if="{{lprResult.error}}">{{lprResult.error}}</view>
    <view class="result-block">
      <view class="result-summary" wx:if="{{lprResult.summaryText}}">
        <text class="result-summary-label">一句话结论</text>
        <text class="result-summary-text">{{lprResult.summaryText}}</text>
      </view>
      <view class="result-actions" wx:if="{{lprResult.valid}}"><button class="result-copy-btn" bindtap="copySummary">复制结果</button></view>
      <view class="result-grid">
        <view class="metric"><text>当前情景利率</text><text>{{lprResult.initialRate}}</text></view>
        <view class="metric"><text>重定价后利率</text><text>{{lprResult.scenarioRate}}</text></view>
        <view class="metric"><text>首期还款</text><text>{{lprResult.firstPayment}}</text></view>
        <view class="metric"><text>重定价当期还款</text><text>{{lprResult.repricePayment}}</text></view>
        <view class="metric main"><text>重定价当期变化</text><text>{{lprResult.paymentChange}}</text></view>
        <view class="metric"><text>总利息</text><text>{{lprResult.totalInterest}}</text></view>
      </view>
    </view>
  </view>

  <view class="schedule" wx:if="{{scheduleTotalCount}}">
    <view class="schedule-head">
      <text class="schedule-title">还款明细</text>
      <view class="schedule-meta">
        <picker class="field-picker" mode="date" fields="month" value="{{scheduleStartYm}}" bindchange="setScheduleStart">
          <text class="schedule-pill">{{scheduleStartYm ? '首期 ' + scheduleStartYm : '设首期年月'}}</text>
        </picker>
        <text class="schedule-count">共 {{scheduleTotalCount}} 期</text>
        <button class="schedule-action share" open-type="share">分享</button>
        <button class="schedule-action export" bindtap="exportSchedulePdf">导出PDF</button>
      </view>
    </view>
    <text class="schedule-truncate-note" wx:if="{{scheduleTruncated}}">页面仅展示前 12 期，完整明细请导出 PDF</text>
    <scroll-view class="table-scroll" scroll-x>
      <view class="table-inner">
        <view class="table-head">
          <text class="table-cell first">月份</text><text class="table-cell amount">还款</text><text class="table-cell amount">本金</text><text class="table-cell amount">利息</text><text class="table-cell amount">余额</text>
        </view>
        <view class="table-row" wx:for="{{activeScheduleDisplay}}" wx:key="month">
          <text class="table-cell first">{{item.label}}</text>
          <text class="table-cell amount">{{item.payment}}</text>
          <text class="table-cell amount">{{item.principal}}</text>
          <text class="table-cell amount">{{item.interest}}</text>
          <text class="table-cell amount">{{item.balance}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="assumption-note">
    <text>默认按等间隔月度还款测算。LPR 情景和提前还款仅按已录入合同、账单和日计数口径估算；未录入费用、实际重定价日和非整月计息都可能造成差异，最终以合同、最新还款计划和结清试算单为准。</text>
  </view>
  </view>
</view>
