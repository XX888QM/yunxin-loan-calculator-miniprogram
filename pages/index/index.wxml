<view class="page quote-page">
  <!-- 首页：报价体检入口 -->
  <view wx:if="{{screenMode == 'home'}}" class="home-screen">
    <view class="home-hero">
      <view class="home-topbar">
        <view class="home-brand">
          <view class="home-brand-mark">
            <image class="home-brand-logo" src="/assets/logo.png" mode="aspectFill" />
          </view>
          <view class="home-brand-copy">
            <text class="home-brand-title">贷款报价体检</text>
            <text class="home-brand-subtitle">看清折算资金成本</text>
          </view>
        </view>
        <button class="home-history-btn" bindtap="openHistory">历史</button>
      </view>
      <view class="home-hero-copy">
        <text class="home-eyebrow">一笔贷款，先做一次体检</text>
        <text class="home-hero-title">看月供，更要看</text>
        <text class="home-hero-title second-line">最后实际花了多少</text>
        <text class="home-hero-desc">填写合同里的金额、期数和费用，帮你把折算年化和已录入成本算明白。</text>
      </view>
      <view class="home-asset-row">
        <button class="home-asset-card car" data-purpose="car" bindtap="startQuoteForPurpose">
          <image src="/assets/quote-car.png" mode="aspectFit" />
          <text class="home-asset-label">买车报价</text>
        </button>
        <button class="home-asset-card home" data-purpose="home" bindtap="startQuoteForPurpose">
          <image src="/assets/quote-home.png" mode="aspectFit" />
          <text class="home-asset-label">买房报价</text>
        </button>
      </view>
    </view>

    <view class="home-content">
      <view class="home-note">
        <text class="home-note-title">不只算月供</text>
        <text class="home-note-text">把前置费用、每期费用和尾款一起放进来，避免只看表面利率。</text>
      </view>
      <button class="primary-action home-start" bindtap="startQuickCalc">开始报价体检</button>
      <button class="secondary-action" bindtap="openTools">直接使用全部工具</button>
      <view class="privacy-note">
        <image class="privacy-logo" src="/assets/quote-shield.png" mode="aspectFit" />
        <view>
          <text class="privacy-title">所有数据仅在本机计算</text>
          <text class="privacy-text">默认不保存；主动保存的报告仅留本机，不上传。</text>
        </view>
      </view>
      <text class="home-version" wx:if="{{appVersion}}">v{{appVersion}}</text>
    </view>
  </view>

  <view wx:elif="{{screenMode == 'quote'}}" class="quote-screen">
    <view class="quote-hero">
      <view class="quote-topbar">
        <view class="quote-brand">
          <view class="quote-brand-mark">
            <image class="quote-brand-logo" src="/assets/logo.png" mode="aspectFill" />
          </view>
          <view class="quote-brand-copy">
            <text class="quote-brand-title">贷款报价体检</text>
            <text class="quote-brand-step">第 <text>{{quoteStep}}</text> 步 / 共 4 步</text>
          </view>
        </view>
      </view>
    </view>

    <view class="quote-progress" aria-label="报价体检进度">
      <view class="quote-progress-line"></view>
      <view class="quote-progress-dot {{quoteStep >= 1 ? 'is-active' : ''}}"><text>1</text></view>
      <view class="quote-progress-dot {{quoteStep >= 2 ? 'is-active' : ''}}"><text>2</text></view>
      <view class="quote-progress-dot {{quoteStep >= 3 ? 'is-active' : ''}}"><text>3</text></view>
      <view class="quote-progress-dot {{quoteStep >= 4 ? 'is-active' : ''}}"><text>4</text></view>
    </view>

    <view class="quote-content">
      <view class="quote-flow-navigation" wx:if="{{quoteStep < 4}}">
        <button class="quote-back-home" bindtap="openHome">返回首页</button>
      </view>
      <view wx:if="{{quoteStep == 1}}" class="quote-step quote-purpose-step">
        <text class="quote-heading">这笔贷款主要用来做什么？</text>
        <text class="quote-lead">选择后会显示对应的填写提示与核对项。</text>
        <view class="quote-inline-error" wx:if="{{quoteError && quoteErrorStep == quoteStep}}">
          <text>{{quoteError}}</text>
        </view>
        <view class="purpose-card-grid">
          <button class="purpose-card purpose-card-car {{quoteSelectedPurpose == 'car' ? 'is-selected' : ''}}" data-purpose="car" bindtap="setQuotePurpose">
            <image class="purpose-image" src="/assets/quote-car.png" mode="aspectFit" />
            <text class="purpose-card-title">买车</text>
            <image class="purpose-check" wx:if="{{quoteSelectedPurpose == 'car'}}" src="/assets/quote-selected-check.png" mode="aspectFit" />
          </button>
          <button class="purpose-card purpose-card-home {{quoteSelectedPurpose == 'home' ? 'is-selected' : ''}}" data-purpose="home" bindtap="setQuotePurpose">
            <image class="purpose-image" src="/assets/quote-home.png" mode="aspectFit" />
            <text class="purpose-card-title">买房</text>
            <image class="purpose-check" wx:if="{{quoteSelectedPurpose == 'home'}}" src="/assets/quote-selected-check.png" mode="aspectFit" />
          </button>
        </view>
        <view class="quote-tip">
          <image class="quote-tip-icon" src="/assets/quote-tip-check.png" mode="aspectFit" />
          <text class="quote-tip-text" wx:if="{{quoteSelectedPurpose == 'car'}}">车贷期限多较短，利率受期限、首付和车型影响。</text>
          <text class="quote-tip-text" wx:elif="{{quoteSelectedPurpose == 'home'}}">房贷请核对重定价、还款方式和提前还款规则。</text>
          <text class="quote-tip-text" wx:else>按合同实际填写，比只看宣传利率更接近真实成本。</text>
        </view>
        <button class="primary-action quote-purpose-next" bindtap="nextQuoteStep">
          <text>下一步：填写贷款金额</text>
        </button>
        <button class="quote-text-action" bindtap="openTools">
          <image class="quote-quick-icon" src="/assets/quote-clock.png" mode="aspectFit" />
          <text>我只想快速算月供</text>
          <image class="quote-quick-arrow" src="/assets/quote-arrow.png" mode="aspectFit" />
        </button>
        <view class="quote-privacy-note">
          <image src="/assets/quote-shield.png" mode="aspectFit" />
          <view class="quote-privacy-copy">
            <text>所有数据仅在本机计算</text>
            <text>不上传，只有你点保存报告才会留在本机。</text>
          </view>
        </view>
      </view>

      <view wx:elif="{{quoteStep == 2}}" class="quote-step">
        <text class="quote-heading">填写贷款金额</text>
        <text class="quote-lead">填写合同贷款本金：不是车价、首付，也不是扣费后到账金额；代扣服务费在下一步填写。</text>
        <view class="quote-inline-error" wx:if="{{quoteError && quoteErrorStep == quoteStep}}">
          <text>{{quoteError}}</text>
        </view>
        <view class="quote-form-card">
          <view class="quote-field">
            <text class="quote-field-label">贷款本金</text>
            <view class="quote-field-control">
              <input class="quote-input" placeholder-class="quote-input-placeholder" placeholder="例如 200000" type="digit" value="{{quoteForm.principal}}" data-form="quoteForm" data-field="principal" bindinput="onInput" />
              <text class="quote-unit">元</text>
            </view>
          </view>
          <view class="quote-field">
            <text class="quote-field-label">还款期数</text>
            <view class="quote-field-control">
              <input class="quote-input" placeholder-class="quote-input-placeholder" placeholder="{{quoteForm.purpose == 'home' ? '例如 360' : '例如 36'}}" type="number" value="{{quoteForm.months}}" data-form="quoteForm" data-field="months" bindinput="onInput" />
              <text class="quote-unit">期</text>
            </view>
          </view>
        </view>
        <view class="quote-form-hint">
          <text wx:if="{{quoteForm.purpose == 'car'}}">车贷通常期限较短；请按合同上的总期数填写。</text>
          <text wx:else>房贷默认 360 期（30 年），请按合同实际总期数修改；已有贷款请使用“提前还款”工具。</text>
        </view>
        <view class="quote-action-row">
          <button class="outline-action quote-action-back" bindtap="previousQuoteStep">上一步</button>
          <button class="primary-action compact quote-action-next" bindtap="nextQuoteStep">下一步</button>
        </view>
      </view>

      <view wx:elif="{{quoteStep == 3}}" class="quote-step">
        <text class="quote-heading">把还款和费用补全</text>
        <text class="quote-lead">费用未核对可先选“未核对”，结果只显示已录入项目的下限。</text>
        <view class="quote-inline-error" wx:if="{{quoteError && quoteErrorStep == quoteStep}}">
          <text>{{quoteError}}</text>
        </view>
        <view class="quote-form-card">
          <text class="quote-section-title">还款结构</text>
          <view class="quote-segmented three">
            <button class="quote-segment-button {{quoteForm.structure == 'equalPayment' ? 'is-selected' : ''}}" data-structure="equalPayment" bindtap="setQuoteStructure">等额月供</button>
            <button class="quote-segment-button {{quoteForm.structure == 'balloon' ? 'is-selected' : ''}}" data-structure="balloon" bindtap="setQuoteStructure">含尾款</button>
            <button class="quote-segment-button {{quoteForm.structure == 'interestOnly' ? 'is-selected' : ''}}" data-structure="interestOnly" bindtap="setQuoteStructure">先息后本</button>
          </view>
          <view class="quote-field">
            <text class="quote-field-label">{{quoteForm.structure == 'interestOnly' ? '每期利息' : '每期还款'}}</text>
            <view class="quote-field-control">
              <input class="quote-input" placeholder-class="quote-input-placeholder" placeholder="按合同填写" type="digit" value="{{quoteForm.monthlyPayment}}" data-form="quoteForm" data-field="monthlyPayment" bindinput="onInput" />
              <text class="quote-unit">元</text>
            </view>
          </view>
          <view class="quote-field" wx:if="{{quoteForm.structure == 'balloon'}}">
            <text class="quote-field-label">末期尾款</text>
            <view class="quote-field-control">
              <input class="quote-input" placeholder-class="quote-input-placeholder" placeholder="最后一期额外还款" type="digit" value="{{quoteForm.balloonAmount}}" data-form="quoteForm" data-field="balloonAmount" bindinput="onInput" />
              <text class="quote-unit">元</text>
            </view>
          </view>
        </view>

        <view class="quote-form-card quote-fee-card">
          <text class="quote-section-title">费用情况</text>
          <view class="quote-segmented three">
            <button class="quote-segment-button {{quoteForm.feeStatus == 'unknown' ? 'is-selected' : ''}}" data-form="quoteForm" data-field="feeStatus" data-value="unknown" bindtap="setFormValue">未核对</button>
            <button class="quote-segment-button {{quoteForm.feeStatus == 'none' ? 'is-selected' : ''}}" data-form="quoteForm" data-field="feeStatus" data-value="none" bindtap="setFormValue">确认无费用</button>
            <button class="quote-segment-button {{quoteForm.feeStatus == 'known' ? 'is-selected' : ''}}" data-form="quoteForm" data-field="feeStatus" data-value="known" bindtap="setFormValue">有费用</button>
          </view>
          <block wx:if="{{quoteForm.feeStatus == 'known'}}">
            <view class="quote-field">
              <text class="quote-field-label">前置费用</text>
              <view class="quote-field-control">
                <input class="quote-input" placeholder-class="quote-input-placeholder" placeholder="确认没有填 0" type="digit" value="{{quoteForm.upfrontFee}}" data-form="quoteForm" data-field="upfrontFee" bindinput="onInput" />
                <text class="quote-unit">元</text>
              </view>
            </view>
            <view class="quote-field">
              <text class="quote-field-label">每期费用</text>
              <view class="quote-field-control">
                <input class="quote-input" placeholder-class="quote-input-placeholder" placeholder="每月固定服务费等" type="digit" value="{{quoteForm.periodicFee}}" data-form="quoteForm" data-field="periodicFee" bindinput="onInput" />
                <text class="quote-unit">元</text>
              </view>
            </view>
          </block>
          <view class="quote-field">
            <text class="quote-field-label">合同或宣传标注利率</text>
            <view class="quote-field-control">
              <input class="quote-input" placeholder-class="quote-input-placeholder" placeholder="选填，用于比较" type="digit" value="{{quoteForm.claimedRate}}" data-form="quoteForm" data-field="claimedRate" bindinput="onInput" />
              <text class="quote-unit">%</text>
            </view>
          </view>
          <view class="quote-segmented two slim">
            <button class="quote-segment-button {{quoteForm.claimedRateMode == 'annual' ? 'is-selected' : ''}}" data-form="quoteForm" data-field="claimedRateMode" data-value="annual" bindtap="setFormValue">标注为年利率</button>
            <button class="quote-segment-button {{quoteForm.claimedRateMode == 'monthly' ? 'is-selected' : ''}}" data-form="quoteForm" data-field="claimedRateMode" data-value="monthly" bindtap="setFormValue">标注为月利率</button>
          </view>
          <text class="quote-form-hint">合同写“平息”或“月费率”时，不要当作月利率比较；请到“平息换算”按合同口径核对。</text>
          <view class="quote-prepay-row">
            <text class="quote-prepay-label">提前还款规则是否已知？</text>
            <view class="quote-inline-choice">
              <button class="quote-inline-button {{quoteForm.prepayKnown == 'yes' ? 'is-selected' : ''}}" data-form="quoteForm" data-field="prepayKnown" data-value="yes" bindtap="setFormValue">已知</button>
              <button class="quote-inline-button {{quoteForm.prepayKnown == 'no' ? 'is-selected' : ''}}" data-form="quoteForm" data-field="prepayKnown" data-value="no" bindtap="setFormValue">不清楚</button>
            </view>
          </view>
        </view>
        <view class="quote-action-row">
          <button class="outline-action quote-action-back" bindtap="previousQuoteStep">上一步</button>
          <button class="primary-action compact quote-action-next" bindtap="nextQuoteStep">查看体检结果</button>
        </view>
      </view>

      <view wx:elif="{{quoteStep == 4}}" class="quote-step quote-result-step">
        <text class="quote-heading">报价体检结果</text>
        <text class="quote-lead">以下结果按你已填写的还款现金流反推。</text>
        <view class="quote-form-error" wx:if="{{quoteResult.error}}">{{quoteResult.error}}</view>
        <block wx:if="{{quoteResult.valid}}">
          <view class="quote-result-hero">
            <text class="quote-result-label">{{quoteResult.rateLabel}}</text>
            <text class="quote-result-value">{{quoteResult.annualEffectiveRate}}</text>
            <text class="quote-result-summary">{{quoteResult.summaryText}}</text>
          </view>
          <text class="quote-form-hint" wx:if="{{quoteResult.purpose == 'home'}}">若合同会随 LPR 重定价，本页只按当前填入的金额测算；后续月供请用“LPR 情景”再核对。</text>
          <view class="quote-result-grid">
            <view class="quote-metric">
              <text>已录入成本合计</text>
              <text>{{quoteResult.totalFinancingCost}}</text>
            </view>
            <view class="quote-metric">
              <text>单项最高已录入支出</text>
              <text>{{quoteResult.maxCashPressure}}</text>
            </view>
            <view class="quote-metric full">
              <text>末期还款</text>
              <text>{{quoteResult.lastPayment}}</text>
            </view>
          </view>
          <text class="quote-form-hint">这不是签约当天总现金；首付、押金和同日多笔费用请按实际相加。</text>
          <view class="quote-checklist">
            <text class="quote-checklist-title">签约前再核对</text>
            <view wx:for="{{quoteResult.checklist}}" wx:key="index" class="quote-check-item">
              <view class="quote-check-dot"></view>
              <text class="quote-check-text">{{item}}</text>
            </view>
          </view>
          <view class="quote-report-actions">
            <view class="quote-report-secondary-row">
              <button class="outline-action report" bindtap="copyQuoteReport">复制结果</button>
              <button class="outline-action report" bindtap="exportQuoteReport">导出报告</button>
            </view>
            <button class="primary-action report quote-report-save" bindtap="saveQuoteReport">保存报告</button>
          </view>
          <button class="quote-compare-add {{!quoteResult.comparable ? 'is-disabled' : ''}}" disabled="{{!quoteResult.comparable}}" bindtap="addQuoteComparison">{{quoteResult.comparable ? '加入报价对比（最多 3 份）' : '费用确认后才能对比'}}</button>
          <view class="quote-compare-card" wx:if="{{quoteComparisons.length}}">
            <text class="quote-compare-title">临时报价对比</text>
            <text class="quote-compare-note">仅比较同用途、费用已确认的报价；费用未核对时不能判断谁更划算。</text>
            <view class="quote-compare-item" wx:for="{{quoteComparisons}}" wx:key="id">
              <view class="quote-compare-copy">
                <text class="quote-compare-purpose">{{item.purpose == 'home' ? '买房报价' : '买车报价'}}</text>
                <text class="quote-compare-detail">年化 {{item.annualEffectiveRate}} · 总成本 {{item.totalFinancingCost}} 元</text>
                <text class="quote-compare-detail">单项最高已录入支出 {{item.maxCashPressure}} 元 · 末期 {{item.lastPayment}} 元</text>
              </view>
              <button class="quote-compare-remove" data-id="{{item.id}}" bindtap="removeQuoteComparison">移除</button>
            </view>
          </view>
          <view class="quote-result-navigation">
            <button class="outline-action" bindtap="previousQuoteStep">修改这份报价</button>
            <button class="outline-action" bindtap="startNewQuote">新建下一份报价</button>
            <button class="quote-home-action" bindtap="openHome">返回首页</button>
          </view>
        </block>
        <view class="quote-action-row" wx:if="{{!quoteResult.valid}}">
          <button class="outline-action quote-action-back" bindtap="previousQuoteStep">返回修改</button>
          <button class="primary-action compact quote-action-next" bindtap="openTools">先用工具计算</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{screenMode == 'history'}}" class="history-screen">
    <view class="history-hero">
      <view class="history-topbar">
        <view class="history-brand">
          <view class="history-brand-mark">
            <image class="history-brand-logo" src="/assets/logo.png" mode="aspectFill" />
          </view>
          <view class="history-brand-copy">
            <text class="history-title">报价体检记录</text>
            <text class="history-subtitle">仅保存在本机</text>
          </view>
        </view>
        <view class="history-top-actions">
          <button class="quote-tools-btn" bindtap="openHome">首页</button>
          <button class="quote-tools-btn" bindtap="openTools">工具</button>
        </view>
      </view>
    </view>
    <view class="history-content">
      <view class="history-heading-row">
        <text class="history-heading">已保存的报告</text>
        <button class="history-clear" wx:if="{{quoteHistory.length}}" bindtap="confirmClearQuoteHistory">清空全部</button>
      </view>
      <view class="history-list" wx:if="{{quoteHistory.length}}">
        <view class="history-item" wx:for="{{quoteHistory}}" wx:key="id">
          <view class="history-item-top">
            <text class="history-item-title">{{item.purpose == 'home' ? '买房报价体检' : '买车报价体检'}}</text>
            <text class="history-item-date">{{item.createdAt}}</text>
          </view>
          <text class="history-item-summary">{{item.summaryText}}</text>
          <view class="history-item-metrics">
            <text class="history-metric-text">{{item.rateLabel}} {{item.annualEffectiveRate}}</text>
            <text class="history-metric-text">{{item.costLabel}} {{item.totalFinancingCost}}</text>
          </view>
          <view class="history-item-actions">
            <button class="history-restore" data-id="{{item.id}}" bindtap="restoreQuoteHistory">打开报告</button>
            <button class="history-delete" data-id="{{item.id}}" bindtap="confirmRemoveQuoteHistory">删除</button>
          </view>
        </view>
      </view>
      <view class="history-empty" wx:else>
        <image class="history-empty-logo" src="/assets/logo.png" mode="aspectFit" />
        <text class="history-empty-title">还没有保存的体检报告</text>
        <text class="history-empty-text">完成一次报价体检后，可以把结果保存到这里。</text>
        <button class="primary-action" bindtap="startQuickCalc">开始报价体检</button>
      </view>
    </view>
  </view>

  <view wx:else class="tools-screen">
  <view class="hero">
    <view class="masthead">
      <view class="brand-block">
        <view class="brand-mark">
          <image class="brand-logo" src="/assets/logo.png" mode="aspectFill" />
        </view>
        <view class="masthead-copy">
          <view class="brand-row">
            <text class="title">全部贷款工具</text>
          </view>
          <text class="subtitle">月供、折算成本和还款明细都能算</text>
        </view>
      </view>
    </view>
    <view class="tools-hero-footer">
      <text class="hero-badge">本地计算 · 不上传 · 仅供测算</text>
      <view class="tools-hero-actions">
        <button class="tools-hero-btn plain" bindtap="openHome">首页</button>
        <button class="tools-hero-btn" bindtap="startQuickCalc">报价体检</button>
        <button class="tools-hero-btn plain" bindtap="openHistory">记录</button>
      </view>
    </view>
  </view>

  <view class="nav-shell">
    <view class="switch-card">
      <text class="section-label">贷款类型</text>
      <view class="segmented two">
        <text wx:for="{{loanTypeList}}" wx:key="value" class="{{loanType == item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setLoanType">{{item.label}}</text>
      </view>
    </view>

    <view class="tool-grid">
      <view wx:for="{{toolList}}" wx:key="value" class="tool {{activeTool == item.value ? 'active' : ''}}" data-tool="{{item.value}}" bindtap="switchTool">{{item.label}}</view>
    </view>

    <view class="tool-guide">
      <text class="tool-guide-text">{{toolHint}}</text>
      <text class="sample-btn" bindtap="fillSample">一键示例</text>
    </view>
  </view>

  <view wx:if="{{activeTool == 'payment'}}" class="panel">
    <view class="segmented two">
      <text class="{{paymentForm.inputMode == 'loan' ? 'active' : ''}}" data-form="paymentForm" data-field="inputMode" data-value="loan" bindtap="setFormValue">填贷款额</text>
      <text class="{{paymentForm.inputMode == 'price' ? 'active' : ''}}" data-form="paymentForm" data-field="inputMode" data-value="price" bindtap="setFormValue">{{loanType == 'car' ? '车价−首付' : '房价−首付'}}</text>
    </view>
    <view class="field" wx:if="{{paymentForm.inputMode == 'loan'}}">
      <text class="label">贷款本金</text>
